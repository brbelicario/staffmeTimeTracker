{
  "manifest_version": 3,
  "name": "SMTracker by B. Belicario",
  "version": "0.4.0",
  "description": "Reads the visible StaffMe hourly table and reports connection status to the time-tracking dashboard.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://staffmetimetracker.pages.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*"
      ],
      "js": [
        "connection-status.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://staffmetimetracker.pages.dev/*"
      ],
      "js": [
        "connection-status.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
