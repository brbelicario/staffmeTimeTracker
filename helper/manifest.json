{
  "manifest_version": 3,
  "name": "SMTracker by B. Belicario",
  "version": "0.5.13",
  "description": "Tracks SM work hours and CB compliance task timing with hourly AHT metrics.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://*.script.googleusercontent.com/*",
    "https://staffmetimetracker.pages.dev/*",
    "https://chaturbate.com/compliance/queue/*",
    "https://*.chaturbate.com/compliance/queue/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SMTracker",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*",
        "https://*.script.googleusercontent.com/*"
      ],
      "js": [
        "connection-status.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*",
        "https://*.script.googleusercontent.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://staffmetimetracker.pages.dev/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://staffmetimetracker.pages.dev/*"
      ],
      "js": [
        "connection-status.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://chaturbate.com/compliance/queue/*",
        "https://*.chaturbate.com/compliance/queue/*"
      ],
      "js": [
        "cb-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
